# Copy to .env and fill in the blanks: cp .env.example .env
# docs/SELF-HOSTING.md explains every setting.
#
# Values are read literally, except that $ and " #" cut a value short. Wrap a password
# containing either in single quotes: SMTP_PASSWORD='pa$word'


# --- Where Endurance is served ---------------------------------------------

ENDURANCE_PORT=8088

# 127.0.0.1 is this machine only; 0.0.0.0 opens it to your network.
ENDURANCE_BIND_ADDRESS=127.0.0.1

# The address people open Endurance at. Verification and unsubscribe links in emails
# point here, so set it whenever that is not http://localhost:8088.
#ENDURANCE_PUBLIC_URL=https://endurance.example.com

# Optional HTTPS through Caddy: set your domain and uncomment both.
#ENDURANCE_DOMAIN=endurance.example.com
#COMPOSE_PROFILES=tls


# --- Database ---------------------------------------------------------------

# Required. Avoid ; and " - for example: openssl rand -base64 24 | tr -d '/+='
# Only applied when the database is first created; changing them later has no effect.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER=endurance


# --- Email ------------------------------------------------------------------

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_FROM=endurance@example.com
SMTP_USERNAME=endurance@example.com
SMTP_PASSWORD=

# STARTTLS. Only set false for a plain-SMTP relay on your own network, and never with a
# username and password. Port 465 (implicit TLS) is not supported; use 587.
SMTP_ENABLE_SSL=true


# --- Miscellaneous ----------------------------------------------------------

# Development enables Swagger, but also stack traces in error responses.
ASPNETCORE_ENVIRONMENT=Production
